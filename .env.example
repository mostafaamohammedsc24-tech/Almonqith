# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional public app URL. Leave empty to use the real browser origin for referral links.
VITE_APP_URL=

# Optional server-side canonical app URL.
APP_URL=

# Required for administrative login. Set strong values in the cloud environment.
ADMIN_PHONE=
ADMIN_PASSWORD=
SESSION_SECRET=

# PostgreSQL connection string for the production database.
DATABASE_URL=

# Optional public WhatsApp destination, in international format.
VITE_WHATSAPP_NUMBER=9647740080310
